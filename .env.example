# ============================================================
# MaintenAI— Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application ---
APP_NAME=FactoryPulse
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (TimescaleDB / PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factorypulse
POSTGRES_USER=factorypulse
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- Qdrant (Vector Database) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider ---
# Supported: openai, gemini, ollama, openrouter
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_KEY=CHANGE_ME_llm_api_key
LLM_BASE_URL=http://localhost:11434/v1

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large

# --- Simulator ---
SIMULATOR_MACHINE_COUNT=20
SIMULATOR_RATE_MS=200
SIMULATOR_TARGET_URL=http://localhost:8003/api/v1/telemetry

# --- Service Ports ---
API_GATEWAY_PORT=8000
INFERENCE_SERVICE_PORT=8001
COPILOT_SERVICE_PORT=8002
INGESTION_SERVICE_PORT=8003
FRONTEND_PORT=3000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Alert Thresholds ---
ALERT_ANOMALY_THRESHOLD=0.85
ALERT_RUL_THRESHOLD=15
ALERT_FAILURE_PROBABILITY_THRESHOLD=0.7

# --- Model Drift ---
DRIFT_PSI_THRESHOLD=0.1
DRIFT_KS_ALPHA=0.05

